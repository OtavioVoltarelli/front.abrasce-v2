# ⚠️ PENDENTE: informar a URL do backend v2 em produção antes de publicar.
# Enquanto esta variável estiver vazia, VITE_API_URL vira string vazia no build
# e toda chamada de API / todo link de arquivo aponta para o lugar errado.
# A URL da v1 era https://www.abrascesocial.org.br/api
VITE_API_URL=

# O site publicado NÃO pode usar mocks.
VITE_USE_MOCKS=false
