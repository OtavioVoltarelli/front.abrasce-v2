# Caminho RELATIVO: o proxy do Vite (vite.config.js) repassa `/api` para o
# backend em localhost:8080. Funciona igual no Mac e no celular, em qualquer
# rede, sem precisar saber o IP da máquina. Só é usado com VITE_USE_MOCKS=false.
VITE_API_URL=/api

# Enquanto for "true", os services devolvem os dados de src/mocks/ e nenhuma
# requisição sai do navegador. Mude para "false" para falar com o backend.
VITE_USE_MOCKS=false
